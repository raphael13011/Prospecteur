# ─── Turso Database ───
# Créer un compte sur turso.tech (gratuit)
# turso db create prospecteur
# turso db tokens create prospecteur
TURSO_URL=libsql://prospecteur-xxxxx.turso.io
TURSO_AUTH_TOKEN=xxxxx

# ─── Auth ───
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ─── Anthropic ───
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx

# ─── Frontend ───
FRONTEND_URL=https://prospecteur.vercel.app
